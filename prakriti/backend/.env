# PRAKRITI Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=PRAKRITI
APP_ENV=development
DEBUG=true

# Database (defaults to SQLite if DATABASE_URL is not set)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/prakriti
# DATABASE_URL=postgresql+asyncpg://prakriti:secret@localhost:5432/prakriti

# Security
SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Configuration
# Set to "real" to use actual model weights (requires additional setup)
# Set to "demo" to use realistic simulation layer (default)
AI_MODE=demo

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# Optional: External integrations (not required for demo)
# OPENAI_API_KEY=
# MAPBOX_TOKEN=
